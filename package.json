{
  "name": "bitpesports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev frontend",
    "build": "npm run db:generate && next build frontend && ln -sfn .next 'Next.js default'",
    "start": "next start frontend",
    "lint": "eslint frontend backend",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema backend/prisma/schema.prisma && npm run admin:backfill-usernames",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "admin:backfill-usernames": "node --env-file=.env --import tsx backend/scripts/backfill-admin-usernames.ts",
    "admin:create": "node --env-file=.env --import tsx backend/scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
